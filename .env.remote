# =================================================================
# Stationly Unified Backend - Remote Overrides Schema
# =================================================================
# This template defines the schema for sensitive environment overrides.
# The deployment scripts will loop through this file and replace
# values from environment variables or secrets.

APP_ENV=
APP_BASE_URL=
APP_WEB_URL=
TFL_APP_KEY=
FIRESTORE_PROJECT_ID=
RESEND_API_KEY=
STATIONLY_ADMIN_KEY=


# Shared secret for the Syncer -> backend live-stream ingest (/internal/*).
# Must match livestream.ingest-secret on the Syncer side.
LIVESTREAM_INGEST_SECRET=

# ── Support / contributions (Stripe) ──
# The deploy script walks THIS file's keys and resolves each from STAGING_<KEY>
# or the matching variable in the local .env, so a secret absent here never
# reaches the box no matter what .env holds. STRIPE_WEBHOOK_SECRET missing is
# not a soft failure: the webhook answers 503 and refuses to process unsigned.
# The URLs are per-environment (test-mode links on staging, live on prod) and
# are public by design; the signing secret is not.
SUPPORT_MONEY_ENABLED=
STRIPE_WEBHOOK_SECRET=
SUPPORT_MONEY_PAYMENT_URL_T4=
SUPPORT_MONEY_PAYMENT_URL_T8=
SUPPORT_MONEY_PAYMENT_URL_T12=
SUPPORT_MONEY_PAYMENT_URL_ONEOFF=
SUPPORT_MONEY_MIN_BOARDS=
SUPPORT_MONEY_MIN_DAYS=
