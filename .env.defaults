# =================================================================
# Stationly Unified Backend - Base Configuration Defaults
# =================================================================
# These parameters are non-sensitive and are safe to expose in Git.
# Both Staging and Production inherit these properties by default.

PORT=3000

# Secure Shared path to Firebase Credentials file
FIREBASE_KEY_PATH=/home/ubuntu/config/firebase-service-account.json

# Transport Settings
TFL_TRANSPORT_MODES=tube,overground,dlr,elizabeth-line,bus
TFL_API_TIMEOUT=30000
TFL_ARRIVAL_PREDICTION_COUNT=-1

# ── Apple Push Notification service ──
# Identifiers, not secrets: the key id and team id are meaningless without the
# private key itself, which is deployed out of band to APNS_P8_PATH (same
# convention as FIREBASE_KEY_PATH above — the deploy script echoes every
# override it writes, so key MATERIAL must never travel through .env.remote).
APNS_KEY_ID=FCDBFFZUBW
APNS_TEAM_ID=7T7D5LLYSL
# APNS_BUNDLE_ID is DERIVED from APP_ENV by `ApnsService.bundleId()` — the topic
# is the app's bundle id and therefore per-environment. Set it here only to
# override that rule (a TestFlight-only id, a rename in flight); left unset,
# production gets `com.stationly.mobile` and staging `com.stationly.mobile.staging`
# by construction, so a new environment cannot inherit the wrong topic.
APNS_P8_PATH=/home/ubuntu/config/apns-auth-key.p8

# ── Support / contributions (Stripe) ──
# Master switch. While 'false' the support card renders nothing, the contextual
# promo is hidden, and the webhook still verifies signatures but has no card to
# back.
#
# DEFAULT 'true' since 2026-09-02, by the owner's decision. This used to be
# 'false' with the note "ship the backend with this OFF". Read the consequence
# before changing it back or relying on it:
#
#   A default is what an environment gets when NOTHING overrides it. The prod
#   workflow exports SUPPORT_MONEY_ENABLED from a repository secret that is not
#   set, which substitutes an empty string, which the assembly loop skips — so
#   production takes THIS value. Production therefore ships with the support
#   surface ENABLED and, until C3/C5 set the live Payment Link secrets, with
#   EMPTY checkout URLs.
#
#   That is inert on the fleet as it stands: the shipped Android APK reads no
#   support_money.* key and has no contribution surface. It stops being inert
#   the moment an iOS build ships a support sheet, because an enabled card with
#   an empty `url` is a button that goes nowhere — the "empty URL is inert"
#   guarantee in SupportMoneyConfigService holds only while `enabled` is false.
#
#   So: set the live links (C3/C5) BEFORE the iOS contribution surface ships,
#   or set the SUPPORT_MONEY_ENABLED repository secret to 'false' to override
#   this default on production. Plan task G4.
SUPPORT_MONEY_ENABLED=true
# Days a one-off contribution keeps the Supporter badge visible. Must match the
# client's `badge.duration_days` (it is served in the SDUI payload, so it does).
SUPPORT_MONEY_BADGE_DURATION_DAYS=30
# Abstract glyph token the clients map to their own asset: heart | coffee | pint | ticket | slice
# 'heart' by default and not 'coffee': the ask is about keeping the app free and
# ad free, not about buying anybody a drink, and the glyph is the first half of
# that sentence. Changing this changes every support surface with a redeploy.
SUPPORT_MONEY_ICON=heart
# The contextual banner, separately from the master switch: 'false' keeps the
# permanent profile card and silences the unprompted ask. Unset = follow SUPPORT_MONEY_ENABLED.
# SUPPORT_MONEY_PROMO_ENABLED=
# Banner thresholds. A fresh install has 1 board and 1 active day, so 1/1 makes
# the flow reachable immediately, including on a fresh production install.
#
# Was 2/3 ("production defaults") until 2026-09-02, changed to 1/1 by the
# owner's decision. The trade is a product one, not a technical one: 1/1 shows
# the contextual ask to a user who has just arrived and not yet got value from
# the app, where 2/3 waited for a second board and a third active day. Nothing
# breaks either way; SUPPORT_MONEY_PROMO_ENABLED=false still silences the
# unprompted ask independently of these.
SUPPORT_MONEY_MIN_BOARDS=1
SUPPORT_MONEY_MIN_DAYS=1
#
# SECRETS / per-environment — set in .env / .env.remote, NEVER here:
#   STRIPE_WEBHOOK_SECRET          whsec_... from the Stripe dashboard webhook endpoint
#   STRIPE_SECRET_KEY              sk_... (only needed if the backend ever calls Stripe; the webhook path does not)
#   SUPPORT_MONEY_PAYMENT_URL_T4         fixed-price Payment Link, GBP 4.00
#   SUPPORT_MONEY_PAYMENT_URL_T8         fixed-price Payment Link, GBP 8.00
#   SUPPORT_MONEY_PAYMENT_URL_T12        fixed-price Payment Link, GBP 12.00
#   SUPPORT_MONEY_PAYMENT_URL_ONEOFF     the "customer chooses what to pay" Payment Link (the custom-amount path,
#                                  and the fallback for any tier whose own link is unset). A Stripe Payment
#                                  Link carries its price in the LINK, not in a query param — hence one link
#                                  per fixed amount rather than one link plus an {amount_minor} placeholder.
#   SUPPORT_MONEY_PAYMENT_URL_MONTHLY   optional recurring link (Phase 1)
#   STRIPE_ALLOW_LIVEMODE_MISMATCH=true   escape hatch for a one-off replay during setup; leave unset

# ── Client version gate ──
# Whether this server is allowed to refuse builds below the floor in
# AppReleaseService.POLICY with HTTP 426. Ships OFF: the gate is infrastructure
# that sits idle until a backend change actually orphans a build, and the first
# thing a switched-on gate can do is misfire.
#
# This is the DEPLOYMENT switch. ReleasePolicy.gateEnabled is the POLICY switch.
# Either being false passes every request through, so there are two ways to
# recover from a mis-set floor and only this one takes effect without a deploy
# (it is read per request, so `pm2 reload --update-env` is enough).
#
# See docs/APP_UPDATE_POLICY.md in the StationlyUI repo before turning it on.
VERSION_GATE_ENABLED=false
